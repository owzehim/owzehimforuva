# Copy to .env.local and use the values for the intended Supabase environment.
# Publishable keys are public client identifiers; never put a secret/service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Use development locally. Vercel Production must explicitly set this to production.
VITE_APP_ENV=development

# Optional public MapTiler browser key. Restrict it to the app domains in MapTiler.
VITE_MAPTILER_API_KEY=
